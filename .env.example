# Required.
ANTHROPIC_API_KEY=sk-ant-...

# claude-opus-5 is the default. claude-sonnet-5 is roughly half the cost and
# fine for the planner/retriever if a full run is getting expensive.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# max_tokens covers thinking + visible output on the 5-series models.
MAX_TOKENS=8000
CHAT_MAX_TOKENS=1024

DATABASE_URL=postgresql+psycopg://agentops:agentops@localhost:5432/agentops

# local  -> markdown files under CORPUS_DIR (no network, used by the eval)
# tavily -> live web search, needs TAVILY_API_KEY
SEARCH_BACKEND=local
CORPUS_DIR=data/corpus
TAVILY_API_KEY=

RESULTS_PER_QUERY=4
MAX_REVISIONS=2
CONFIDENCE_FLOOR=0.85
HISTORY_TURNS=10

# Hard ceiling on spend for one process. Every model call is metered; the run
# aborts once the total crosses this. 0 disables the cap.
MAX_SPEND_USD=5
